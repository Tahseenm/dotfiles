# Main workstation (macbook)
#
# Homebrew Bundle has no include directive, so install.sh installs
# Brewfile.base first and then this file. Base is never duplicated.

tap "teamookla/speedtest", trusted: true

brew "mas"                                     # Mac App Store command-line interface
brew "teamookla/speedtest/speedtest"           # Ookla Speedtest

# GUI applications
# Zoom and Microsoft Teams require admin privileges; install via the manual steps.
cask "raycast"               # Mac command center/launcher
cask "google-chrome"         # Web browser by Google
cask "figma"                 # Interface design tool
cask "paper-design"          # (Paper) Agentic interface design tool
cask "iina"                  # Media player
cask "stremio"               # Streaming media app
cask "warp"                  # AI-powered terminal
cask "visual-studio-code"    # Code editor
cask "docker-desktop"        # Container development environment
cask "chatgpt"               # OpenAI ChatGPT desktop app
cask "claude"                # Anthropic Claude desktop app
cask "discord"               # Voice, video & text chat
cask "whatsapp"              # Messaging & calling app
cask "datagrip"              # JetBrains database IDE
cask "rustdesk"              # Remote desktop

# Fonts
cask "font-fira-code"               # Fira Code programming font
cask "font-fira-code-nerd-font"     # Fira Code with Nerd Font glyphs

# Mac App Store
mas "Blackmagic Disk Speed Test", id: 425264550
mas "ColorSlurp", id: 1287239339
mas "GoodLinks", id: 1474335294
mas "iA Writer", id: 775737590
mas "Jomo", id: 1609960918
mas "Keynote", id: 361285480
mas "Kindle", id: 302584613
mas "Numbers", id: 409203825
mas "Pages", id: 361309726
mas "Surfshark", id: 1437809329
mas "Xcode", id: 497799835
